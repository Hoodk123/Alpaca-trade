# Alpaca paper trading keys (free — sign up at https://alpaca.markets)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER=true

# LLM provider — pick ONE and fill in the matching key
# Option A: NVIDIA NIM free tier (OpenAI-compatible endpoint)
LLM_PROVIDER=nvidia
LLM_API_KEY=your_nvidia_api_key_here
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Option B: OpenAI (uncomment and fill if you'd rather use this)
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
